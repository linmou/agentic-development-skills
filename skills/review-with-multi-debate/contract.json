{
  "contract_format": "skill-contract/1",
  "skill": "review-with-multi-debate",
  "version": "1.0.0",
  "capability": "Audit an artifact against a claim with three independent reviewers and criterion-level convergence.",
  "prose_contract": "references/call-contract.md",
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "artifact",
      "claim"
    ],
    "properties": {
      "artifact": {
        "type": "string",
        "minLength": 1,
        "description": "Path, diff, document, or inline text under review."
      },
      "claim": {
        "type": "string",
        "minLength": 1,
        "description": "Statement the artifact must satisfy."
      },
      "feature_name": {
        "type": "string",
        "minLength": 1,
        "description": "Default: derived from the claim."
      },
      "phase": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque file-name label; default review; never control."
      },
      "evidence": {
        "type": "array",
        "description": "Paths or excerpts for reviewers, including test output. Default []."
      },
      "frozen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criteria_manifest",
          "bundle_path"
        ],
        "properties": {
          "criteria_manifest": {
            "type": "string",
            "minLength": 1
          },
          "bundle_path": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "require_reviewer_provenance": {
        "type": "boolean",
        "description": "Default false."
      },
      "audit_dir": {
        "type": "string",
        "minLength": 1,
        "description": "Default audits."
      },
      "caller_tag": {
        "type": "string",
        "description": "Opaque; echoed, never control."
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "status",
      "disputed_criteria",
      "errors"
    ],
    "properties": {
      "status": {
        "enum": [
          "converged",
          "unresolved",
          "error"
        ]
      },
      "overall_verdict": {
        "enum": [
          "pass",
          "fail",
          "insufficient_evidence"
        ],
        "description": "When converged."
      },
      "blocking_criteria": {
        "type": "array"
      },
      "disputed_criteria": {
        "type": "array"
      },
      "iterations": {
        "type": "integer"
      },
      "summary_path": {
        "type": "string"
      },
      "audit_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "review_bundle_id": {
        "type": "string"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "caller_tag": {
        "type": "string"
      }
    },
    "description": "The skill's final answer, not a file. The per-round summary file has its own schema (call-contract.md, Round summary)."
  },
  "status_field": "status",
  "statuses": [
    "converged",
    "unresolved",
    "error"
  ],
  "writes": [
    {
      "store": "review-audits",
      "location": "request.audit_dir/<feature_name>_<phase>_{auditN_iterationM,iterationM_summary}.json; frozen bundle at request.frozen.bundle_path"
    }
  ],
  "high_stakes": true,
  "changes": [
    {
      "version": "1.0.0",
      "note": "First contract. Phase default becomes the neutral label review; frozen rounds and reviewer provenance are caller-requested options owned by this skill; gate commands are part of the contract."
    }
  ]
}
